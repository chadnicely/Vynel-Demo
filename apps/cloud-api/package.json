{
  "name": "@vynel/cloud-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@vynel/accounts": "workspace:*",
    "@vynel/cloud-db": "workspace:*",
    "@vynel/errors": "workspace:*",
    "@vynel/logger": "workspace:*",
    "hono": "^4.6.0",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vynel/hub-account": "workspace:*",
    "jose": "^5.9.0",
    "typescript": "^5.6.0"
  }
}
