{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vynel",
  "version": "0.0.0",
  "identifier": "app.vynel.desktop",
  "build": {
    "devUrl": "http://localhost:8999",
    "frontendDist": "../../local-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "jarvis",
        "url": "/jarvis",
        "title": "Vynel Jarvis",
        "width": 420,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
