{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser app — vue-tsc needs Bundler semantics for .vue modules.
    // Imports still follow the house `.js` rule (TS/Vite substitute .js → .ts);
    // see docs/module-notes/desktop-ui.md "deviations".
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
