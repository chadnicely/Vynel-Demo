{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node-context config files (vite/vitest boot through esbuild → bundler semantics).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
