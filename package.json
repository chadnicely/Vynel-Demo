{
  "name": "vynel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@vynel/local-api --filter=@vynel/web",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:unit": "vitest run",
    "test:parity": "tsx scripts/src/generators/check-schema-parity.ts && tsx scripts/src/generators/check-mcp-parity.ts && tsx scripts/src/generators/check-sdk-parity.ts",
    "test": "turbo run typecheck && pnpm test:parity && vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "tsx scripts/src/generators/generate-sdk.ts && tsx scripts/src/generators/generate-namespaced-sdk.ts && tsx scripts/src/generators/generate-mcp-tools.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-import-x": "^4.5.0",
    "eslint-plugin-vue": "^9.31.0",
    "globals": "^15.13.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9.4.0"
  }
}
