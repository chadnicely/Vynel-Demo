{
  "name": "vynel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm db:up && turbo run dev --filter=@vynel/cloud-api --filter=@vynel/local-api --filter=@vynel/local-web",
    "dev:local": "turbo run dev --filter=@vynel/local-api --filter=@vynel/local-web",
    "dev:voice": "pnpm --filter @vynel/voice-daemon dev",
    "dev:full": "pnpm db:up && turbo run dev --filter=@vynel/cloud-api --filter=@vynel/cloud-admin-web --filter=@vynel/local-api --filter=@vynel/local-web --filter=@vynel/voice-daemon",
    "dev:all": "turbo run dev",
    "db:up": "pnpm --filter @vynel/cloud-api db:up",
    "db:down": "pnpm --filter @vynel/cloud-api db:down",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:unit": "vitest run",
    "test:parity": "tsx scripts/src/generators/check-schema-parity.ts && tsx scripts/src/generators/check-mcp-parity.ts && tsx scripts/src/generators/check-sdk-parity.ts && tsx scripts/src/generators/check-port-parity.ts",
    "test": "turbo run typecheck && pnpm test:parity && vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "tsx scripts/src/generators/generate-sdk.ts && tsx scripts/src/generators/generate-namespaced-sdk.ts && tsx scripts/src/generators/generate-mcp-tools.ts",
    "release:payload": "tsx scripts/src/release/build-payload.ts",
    "release:verify": "tsx scripts/src/release/verify-payload.ts",
    "release:pack": "tsx scripts/src/release/pack-payload.ts",
    "release:desktop": "tsx scripts/src/release/build-desktop.ts",
    "release:cli": "tsx scripts/src/release/build-cli.ts",
    "release:cli-verify": "tsx scripts/src/release/verify-cli.ts",
    "cloud:generate-keys": "tsx scripts/src/cloud/generate-cloud-keys.ts",
    "cloud:publish": "tsx --env-file-if-exists=.env scripts/src/cloud/publish-catalog-item.ts",
    "cloud:import-anthropic": "tsx --env-file-if-exists=.env scripts/src/cloud/import-anthropic-skills.ts",
    "cloud:check-anthropic": "tsx scripts/src/cloud/check-anthropic-upstream.ts",
    "voice:fetch-models": "tsx scripts/src/voice/fetch-voice-models.ts",
    "voice:smoke": "tsx scripts/src/voice/synthesize-smoke.ts",
    "voice:bench": "tsx scripts/src/voice/benchmark.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-import-x": "^4.5.0",
    "eslint-plugin-vue": "^9.31.0",
    "globals": "^15.13.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9.4.0"
  }
}
