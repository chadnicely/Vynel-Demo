{
  "openapi": "3.1.0",
  "info": {
    "title": "Vynel API",
    "description": "Vynel — desktop AI assistant for non-technical knowledge workers. Phase 1 ships locally; single-user.",
    "version": "0.1.0"
  },
  "paths": {
    "/workspaces/{workspaceId}/knowledge/documents": {
      "get": {
        "responses": {
          "200": {
            "description": "{ documents: SerializedKnowledgeDocument[], nextCursor }.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "userId": {
                            "type": "string"
                          },
                          "workspaceId": {
                            "type": "string"
                          },
                          "relativePath": {
                            "type": "string"
                          },
                          "documentKind": {
                            "type": "string",
                            "enum": [
                              "markdown",
                              "plain-text",
                              "pdf",
                              "docx",
                              "html",
                              "csv",
                              "json",
                              "unsupported"
                            ]
                          },
                          "contentHash": {
                            "type": "string"
                          },
                          "fileSizeBytes": {
                            "type": "number"
                          },
                          "fileModifiedAt": {
                            "type": "string"
                          },
                          "chunkCount": {
                            "type": "number"
                          },
                          "parseStatus": {
                            "type": "string",
                            "enum": [
                              "pending",
                              "parsing",
                              "parsed",
                              "failed",
                              "skipped"
                            ]
                          },
                          "parseErrorMessage": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "indexedAt": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "userId",
                          "workspaceId",
                          "relativePath",
                          "documentKind",
                          "contentHash",
                          "fileSizeBytes",
                          "fileModifiedAt",
                          "chunkCount",
                          "parseStatus",
                          "parseErrorMessage",
                          "indexedAt",
                          "createdAt",
                          "updatedAt"
                        ]
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "indexedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "indexedAt",
                        "id"
                      ]
                    }
                  },
                  "required": [
                    "documents",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Workspace not found."
          }
        },
        "operationId": "getWorkspacesByWorkspaceIdKnowledgeDocuments",
        "tags": [
          "knowledge"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "documentKind",
            "schema": {
              "type": "string",
              "enum": [
                "markdown",
                "plain-text",
                "pdf",
                "docx",
                "html",
                "csv",
                "json",
                "unsupported"
              ]
            }
          },
          {
            "in": "query",
            "name": "cursorIndexedAt",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "cursorId",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "in": "query",
            "name": "path",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "summary": "List indexed documents for the active workspace.",
        "x-sdk-name": "knowledge.listDocuments",
        "x-mcp": {
          "exposed": true,
          "name": "list_knowledge_documents",
          "description": "List indexed knowledge documents for the active workspace (owner-scoped — only the authenticated user's documents). Supports filtering by documentKind (markdown / plain-text / pdf / docx / html / csv / json), or by an exact `path` (workspace-relative) to fetch the single matching document. Cursor-paginated by (indexedAt DESC NULLS LAST, id DESC). Read-only."
        }
      }
    },
    "/workspaces/{workspaceId}/knowledge/documents/{documentId}": {
      "get": {
        "responses": {
          "200": {
            "description": "{ document: SerializedKnowledgeDocument, chunks: SerializedKnowledgeChunk[] }.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "userId": {
                          "type": "string"
                        },
                        "workspaceId": {
                          "type": "string"
                        },
                        "relativePath": {
                          "type": "string"
                        },
                        "documentKind": {
                          "type": "string",
                          "enum": [
                            "markdown",
                            "plain-text",
                            "pdf",
                            "docx",
                            "html",
                            "csv",
                            "json",
                            "unsupported"
                          ]
                        },
                        "contentHash": {
                          "type": "string"
                        },
                        "fileSizeBytes": {
                          "type": "number"
                        },
                        "fileModifiedAt": {
                          "type": "string"
                        },
                        "chunkCount": {
                          "type": "number"
                        },
                        "parseStatus": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "parsing",
                            "parsed",
                            "failed",
                            "skipped"
                          ]
                        },
                        "parseErrorMessage": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "indexedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "updatedAt": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "userId",
                        "workspaceId",
                        "relativePath",
                        "documentKind",
                        "contentHash",
                        "fileSizeBytes",
                        "fileModifiedAt",
                        "chunkCount",
                        "parseStatus",
                        "parseErrorMessage",
                        "indexedAt",
                        "createdAt",
                        "updatedAt"
                      ]
                    },
                    "chunks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "documentId": {
                            "type": "string"
                          },
                          "workspaceId": {
                            "type": "string"
                          },
                          "chunkIndex": {
                            "type": "number"
                          },
                          "startCharOffset": {
                            "type": "number"
                          },
                          "endCharOffset": {
                            "type": "number"
                          },
                          "chunkText": {
                            "type": "string"
                          },
                          "chunkTokenEstimate": {
                            "type": "number"
                          },
                          "embeddingPresent": {
                            "type": "boolean"
                          },
                          "embeddingModelVersion": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "createdAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "documentId",
                          "workspaceId",
                          "chunkIndex",
                          "startCharOffset",
                          "endCharOffset",
                          "chunkText",
                          "chunkTokenEstimate",
                          "embeddingPresent",
                          "embeddingModelVersion",
                          "createdAt"
                        ]
                      }
                    }
                  },
                  "required": [
                    "document",
                    "chunks"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Knowledge document not found in this workspace."
          }
        },
        "operationId": "getWorkspacesByWorkspaceIdKnowledgeDocumentsByDocumentId",
        "tags": [
          "knowledge"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "summary": "Get one knowledge document + its chunks (workspace-scoped).",
        "x-sdk-name": "knowledge.getDocument",
        "x-mcp": {
          "exposed": true,
          "name": "get_knowledge_document",
          "description": "Get one knowledge document by id, along with its parsed chunks. Owner-scoped — returns 404 if the document does not belong to the active workspace. The chunks carry character offsets + token estimates; the chunkText is the parsed-and-normalized content used for both FTS and semantic search. Read-only."
        }
      }
    },
    "/workspaces/{workspaceId}/knowledge/search": {
      "get": {
        "responses": {
          "200": {
            "description": "{ results: SerializedKnowledgeSearchResult[] }.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "chunkId": {
                            "type": "string"
                          },
                          "documentId": {
                            "type": "string"
                          },
                          "relativePath": {
                            "type": "string"
                          },
                          "documentKind": {
                            "type": "string",
                            "enum": [
                              "markdown",
                              "plain-text",
                              "pdf",
                              "docx",
                              "html",
                              "csv",
                              "json",
                              "unsupported"
                            ]
                          },
                          "chunkIndex": {
                            "type": "number"
                          },
                          "chunkText": {
                            "type": "string"
                          },
                          "ftsScore": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "semanticScore": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "combinedScore": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "chunkId",
                          "documentId",
                          "relativePath",
                          "documentKind",
                          "chunkIndex",
                          "chunkText",
                          "ftsScore",
                          "semanticScore",
                          "combinedScore"
                        ]
                      }
                    }
                  },
                  "required": [
                    "results"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Workspace not found."
          }
        },
        "operationId": "getWorkspacesByWorkspaceIdKnowledgeSearch",
        "tags": [
          "knowledge"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "required": true
          },
          {
            "in": "query",
            "name": "mode",
            "schema": {
              "type": "string",
              "enum": [
                "fts",
                "semantic",
                "hybrid"
              ]
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required": false
          },
          {
            "in": "query",
            "name": "documentKindFilter",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "summary": "Search knowledge chunks (FTS5, semantic, or hybrid).",
        "x-sdk-name": "knowledge.search",
        "x-mcp": {
          "exposed": true,
          "name": "search_knowledge",
          "description": "Search the workspace's indexed documents by text query. Mode: \"fts\" (FTS5 keyword), \"semantic\" (sqlite-vec cosine over MiniLM-L6-v2 embeddings), or \"hybrid\" (default; Reciprocal Rank Fusion k=60). Returns up to `limit` matching chunks with FTS snippet (literal <mark> tokens) + scores. Optional documentKindFilter is a comma-separated list of document kinds to restrict to. Owner-scoped. Read-only."
        }
      }
    },
    "/workspaces/{workspaceId}/knowledge/status": {
      "get": {
        "responses": {
          "200": {
            "description": "SerializedIndexerStatus.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "workspaceId": {
                      "type": "string"
                    },
                    "totalDocuments": {
                      "type": "number"
                    },
                    "parsedDocuments": {
                      "type": "number"
                    },
                    "pendingDocuments": {
                      "type": "number"
                    },
                    "parsingDocuments": {
                      "type": "number"
                    },
                    "failedDocuments": {
                      "type": "number"
                    },
                    "skippedDocuments": {
                      "type": "number"
                    },
                    "unindexedChunks": {
                      "type": "number"
                    },
                    "lastIndexedAt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "workspaceId",
                    "totalDocuments",
                    "parsedDocuments",
                    "pendingDocuments",
                    "parsingDocuments",
                    "failedDocuments",
                    "skippedDocuments",
                    "unindexedChunks",
                    "lastIndexedAt"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Workspace not found."
          }
        },
        "operationId": "getWorkspacesByWorkspaceIdKnowledgeStatus",
        "tags": [
          "knowledge"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "summary": "Get the indexer status for the active workspace.",
        "x-sdk-name": "knowledge.getStatus",
        "x-mcp": {
          "exposed": true,
          "name": "get_indexer_status",
          "description": "Return the indexer status for the active workspace: total documents, per-parse-state counts (parsed / pending / parsing / failed / skipped), the count of chunks awaiting embedding generation, and the most recent indexed-at timestamp. Read-only."
        }
      }
    },
    "/workspaces/{workspaceId}/knowledge/reindex": {
      "post": {
        "responses": {
          "200": {
            "description": "{ indexedCount, skippedCount, failedCount }.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "indexedCount": {
                      "type": "number"
                    },
                    "skippedCount": {
                      "type": "number"
                    },
                    "failedCount": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "indexedCount",
                    "skippedCount",
                    "failedCount"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Workspace not found."
          }
        },
        "operationId": "postWorkspacesByWorkspaceIdKnowledgeReindex",
        "tags": [
          "knowledge"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "summary": "Force-reindex every document in the active workspace.",
        "x-sdk-name": "knowledge.reindex"
      }
    },
    "/workspaces/{workspaceId}/knowledge/sources": {
      "post": {
        "responses": {
          "200": {
            "description": "{ source: SerializedKnowledgeSource, indexed: { indexedCount, skippedCount, failedCount } }.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "userId": {
                          "type": "string"
                        },
                        "workspaceId": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "scope": {
                          "type": "string",
                          "enum": [
                            "workspace",
                            "global"
                          ]
                        },
                        "absolutePath": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "updatedAt": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "userId",
                        "workspaceId",
                        "scope",
                        "absolutePath",
                        "createdAt",
                        "updatedAt"
                      ]
                    },
                    "indexed": {
                      "type": "object",
                      "properties": {
                        "indexedCount": {
                          "type": "number"
                        },
                        "skippedCount": {
                          "type": "number"
                        },
                        "failedCount": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "indexedCount",
                        "skippedCount",
                        "failedCount"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "indexed"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Workspace not found."
          }
        },
        "operationId": "postWorkspacesByWorkspaceIdKnowledgeSources",
        "tags": [
          "knowledge"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "summary": "Register a directory to index, at workspace or global scope.",
        "x-sdk-name": "knowledge.addDirectory",
        "x-mcp": {
          "exposed": true,
          "name": "add_to_knowledge",
          "mutatingApproved": true,
          "description": "Add a directory to the knowledge base so its files are indexed for search. `absolutePath` is the directory on disk; `scope` is \"workspace\" (indexed for the active workspace) or \"global\" (indexed for the user across all workspaces). Registers the source, starts watching it for changes, and indexes its current files. Mutating."
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "absolutePath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "workspace",
                      "global"
                    ]
                  }
                },
                "required": [
                  "absolutePath",
                  "scope"
                ]
              }
            }
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "{ sources: SerializedKnowledgeSource[] }.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "userId": {
                            "type": "string"
                          },
                          "workspaceId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "scope": {
                            "type": "string",
                            "enum": [
                              "workspace",
                              "global"
                            ]
                          },
                          "absolutePath": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "userId",
                          "workspaceId",
                          "scope",
                          "absolutePath",
                          "createdAt",
                          "updatedAt"
                        ]
                      }
                    }
                  },
                  "required": [
                    "sources"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Workspace not found."
          }
        },
        "operationId": "getWorkspacesByWorkspaceIdKnowledgeSources",
        "tags": [
          "knowledge"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "summary": "List registered knowledge sources (the workspace's + the user's global sources).",
        "x-sdk-name": "knowledge.listSources",
        "x-mcp": {
          "exposed": true,
          "name": "list_knowledge_sources",
          "description": "List the registered knowledge sources in scope for the active workspace: the workspace's own sources plus the user's global sources. Each carries its absolute path, scope, and timestamps. Read-only."
        }
      }
    },
    "/workspaces/{workspaceId}/knowledge/sources/{sourceId}": {
      "delete": {
        "responses": {
          "200": {
            "description": "{ removed: boolean }.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "removed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "removed"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Workspace not found."
          }
        },
        "operationId": "deleteWorkspacesByWorkspaceIdKnowledgeSourcesBySourceId",
        "tags": [
          "knowledge"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "sourceId",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          }
        ],
        "summary": "Remove a registered knowledge source (stops watching; purges its docs + chunks).",
        "x-sdk-name": "knowledge.removeSource",
        "x-mcp": {
          "exposed": true,
          "name": "remove_knowledge_source",
          "mutatingApproved": true,
          "description": "Remove a registered knowledge source by id. Stops watching its directory and purges its indexed documents + chunks (cascade). Idempotent — removing an unknown id is a no-op. Mutating."
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
