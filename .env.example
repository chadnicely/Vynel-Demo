# Vynel local development environment. Copy to `.env` (gitignored) and adjust.
# Every var is Zod-validated in each app's `env.ts` at boot — no `process.env` access elsewhere.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- HTTP daemon (apps/local-api) ------------------------------------------------
PORT=18892

# ---- Database (Phase 1: SQLite via better-sqlite3) -------------------------
DB_DIALECT=sqlite
DB_PATH=./.data/vynel.dev.db
# Phase 2 flips to Postgres: DB_DIALECT=postgres + DB_URL=postgres://...
# DB_URL=

# ---- Frontend dev server (apps/local-web) ----------------------------------
LOCAL_WEB_PORT=18894

# ---- Session / desktop -----------------------------------------------------
# VYNEL_USER_DATA_DIR=            # global-root data dir (defaults to ~/.vynel)
# VYNEL_DESKTOP_ACT_ENABLED=false # desktop mutating actions safety gate (default OFF)

# ---- Releases / distribution (all optional in dev) -------------------------
# Hub update endpoint's manifest source — defaults to the public GitHub
# releases repo; override only to test the hub endpoint against another URL.
# CLOUD_RELEASES_MANIFEST_URL=

# Release builds (`pnpm release:desktop`) read the SHELL env, never this file:
#   TAURI_SIGNING_PRIVATE_KEY           minisign updater key (required; content or
#                                       out-of-repo path, from the password manager)
#   TAURI_SIGNING_PRIVATE_KEY_PASSWORD  if the key is password-protected
# Authenticode signing (post-demo, Chad) — all six or none:
#   VYNEL_SIGN_ENDPOINT / VYNEL_SIGN_ACCOUNT / VYNEL_SIGN_PROFILE
#   AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET
# Hub-configured installers additionally read VYNEL_HUB_URL + VYNEL_HUB_PUBLIC_KEY
# at build time (bakes release.env AND the hub-first updater endpoint).
